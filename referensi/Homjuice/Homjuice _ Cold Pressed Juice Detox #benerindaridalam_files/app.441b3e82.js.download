    #nprogress {
      pointer-events: none;
    }

    #nprogress .bar {
      background: `+d+`;

      position: fixed;
      z-index: 1031;
      top: 0;
      left: 0;

      width: 100%;
      height: 2px;
    }

    #nprogress .peg {
      display: block;
      position: absolute;
      right: 0px;
      width: 100px;
      height: 100%;
      box-shadow: 0 0 10px `+d+", 0 0 5px "+d+`;
      opacity: 1.0;

